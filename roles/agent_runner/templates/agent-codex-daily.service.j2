{# agent-runner 的 system-level Codex service；认证来自独立 CODEX_HOME 的 OAuth 登录态。 #}
[Unit]
Description=Daily Codex automation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ nuc_agent_runner_user }}
Group={{ nuc_agent_runner_user }}
WorkingDirectory={{ nuc_agent_runner_workdir }}
Environment=HOME={{ nuc_agent_runner_home }}
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=CODEX_HOME={{ nuc_agent_runner_codex_home }}
UnsetEnvironment=OPENAI_API_KEY OPENAI_ADMIN_KEY
ExecStart=/usr/local/bin/codex exec --sandbox workspace-write --ask-for-approval never "{{ nuc_agent_runner_task_prompt }}"
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ nuc_agent_runner_workdir }} {{ nuc_agent_runner_home }}
