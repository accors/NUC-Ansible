{
  "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
  "version": 1,
  "features": {
    "webUi": { "enabled": true }
  },
  "daemon": {
    "listen": "{{ nuc_tailscale_ipv4 }}:{{ nuc_paseo_port }}",
    "hostnames": [
      "{{ nuc_tailscale_ipv4 }}",
      "{{ nuc_access_hostname }}"
    ],
    "relay": { "enabled": false }
  }
}
