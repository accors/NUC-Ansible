[Unit]
Description=Paseo daemon

[Service]
Type=simple
# PATH 必须包含 codex role 探测到的实际目录与管理员的 Paseo npm bin。
Environment=PATH={{ nuc_paseo_unit_path }}
ExecStart={{ nuc_admin_home }}/{{ nuc_paseo_npm_prefix_relative }}/bin/paseo daemon start --foreground
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120s

[Install]
WantedBy=default.target
