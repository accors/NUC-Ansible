{#
  restic 的 root-only 环境文件（0600 root:root，写入任务带 no_log）。
  systemd EnvironmentFile 会剥掉外层引号，因此用 to_json 保证值里的空格、
  引号等字符不会把一行拆成两个变量。

  S3 类后端（Cloudflare R2、AWS S3、MinIO 等）的凭据只在这里出现，
  不进 nuc_restic_repository —— 契约要求仓库地址里不得嵌入账号或密钥。
#}
RESTIC_REPOSITORY={{ nuc_restic_repository | to_json(ensure_ascii=False) }}
RESTIC_PASSWORD={{ vault_nuc_restic_password | to_json(ensure_ascii=False) }}
{% if (vault_nuc_restic_s3_access_key_id | default('') | trim | length) > 0 %}
AWS_ACCESS_KEY_ID={{ vault_nuc_restic_s3_access_key_id | to_json(ensure_ascii=False) }}
AWS_SECRET_ACCESS_KEY={{ vault_nuc_restic_s3_secret_access_key | to_json(ensure_ascii=False) }}
AWS_DEFAULT_REGION={{ nuc_restic_s3_region | to_json(ensure_ascii=False) }}
{% endif %}
